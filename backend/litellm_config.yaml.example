model_list:
  # The application only sees this logical model name.
  - model_name: analysis-model
    litellm_params:
      model: openai/glm-5.3-flash
      api_base: https://tokenrhythm.studio/v1
      api_key: xxxxxx

  # This can point to a different provider or self-hosted service.
  - model_name: rca-model
    litellm_params:
      model: openai/glm-5.3-flash
      api_base: https://tokenrhythm.studio/v1
      api_key: xxxxxxx

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
