# Application storage and authentication
APP_DATA_ROOT=./data
APP_DATABASE_PATH=./data/logsys.db
SESSION_EXPIRE_HOURS=24
ALLOW_REGISTRATION=true
MAX_UPLOAD_MB=200
# Log time-range precheck before Drain/RCA. Large or discontinuous ranges wait for user confirmation.
LOG_PRECHECK_CONFIRMATION_HOURS=24
LOG_PRECHECK_SEGMENT_GAP_HOURS=6
LOG_PRECHECK_MAX_FILES=2000
LOG_PRECHECK_UNCOMPRESSED_MULTIPLIER=5
LOG_PRECHECK_MAX_SELECTION_DAYS=7

# Local LLM service. Use the same address that your test.py can call successfully.
LLM_BASE_URL=http://10.10.3.104:1234
LLM_MODEL=qwen3.5_14B_Q4_K_M
LLM_API_KEY=not-needed
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=180
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_MAX_TOKENS=2048
LLM_CHUNK_CHARS=8000
LLM_DISABLE_THINKING=true
LLM_DISABLE_ENV_PROXY=true

# Keep this false unless you specifically want to test LangChain. Direct HTTP is more stable for local OpenAI-compatible servers.
LLM_USE_LANGCHAIN_FIRST=false

# HugeGraph REST
HUGEGRAPH_HOST=10.10.3.104
HUGEGRAPH_PORT=8080
HUGEGRAPH_GRAPHSPACE=DEFAULT
HUGEGRAPH_GRAPH=hugegraph
HUGEGRAPH_TIMEOUT_SECONDS=30
HUGEGRAPH_NODE_LABEL=LogSysKGNodeV7
HUGEGRAPH_EDGE_LABEL=LOGSYS_KG_RELATION_V7

# Optional: point to the v1-goat spring-log-system repo if you want /api/logs/analyze to run the sliding-window algorithm directly.
LOGFAULT_PROJECT_PATH=./lib
LOGFAULT_CONFIG_PATH=./lib/logfault/config/default.yaml
LOGFAULT_OUTPUT_ROOT=./runs/kg
INCIDENT_TIMELINE_LIMIT=120
RCA_TOP_K=5

# Company LLM
# 这个路径一点都不能动，包括最后的斜杠
RCA_DECISION_URL=http://10.6.2.178:12135/api/conversation/
RCA_DECISION_MODEL_CONFIG_ID=bdaed4950f9340e4ba7716e01711d2fe
RCA_DECISION_ASSISTANT_PROMPT=你是系统架构知识图谱抽取器。禁止输出思考过程，只输出一个 JSON 对象。JSON 格式固定为：{"services":[{"name":"节点名","layer":"层级","kind":"Service|Database|Cache|Middleware|Queue|API|Function|Layer|System|Component|Cluster|Instance|Host|Pod","description":"描述","meta":{"aliases":[],"host":"","port":""}}],"calls":[{"source":"起点节点名","target":"终点节点名","type":"CALLS|USES_DB|CONTAINS|BELONGS_TO_LAYER|PROVIDES|DEPENDS_ON|READS|WRITES|PUBLISHES|SUBSCRIBES|HAS_MEMBER|RUNS_ON|CONNECTS_TO","description":"描述","meta":{}}]}规则：1. 文档里的系统、层、服务、数据库、中间件、队列、接口、功能都要作为 services 节点。2. calls 中的 source 和 target 必须能在 services 里找到。3. 集群和实例必须分开建模，例如“Redis集群 -HAS_MEMBER-> redis-1”；服务依赖基础设施用 DEPENDS_ON。4. 文档给出别名、主机名、IP、端口时放入 meta；未给出的信息禁止猜测。5. 不要 Markdown，不要代码块，不要解释，不要 <think>。

# Deterministic log compression before the final RCA decision model.
LOG_COMPRESSION_ENABLED=true
# Character budget for incident.log_context JSON. Adjust this to your model context window.
LOG_COMPRESSION_MAX_CHARS=12000
# Maximum number of selected key events after scoring and temporal-neighbor expansion.
LOG_COMPRESSION_MAX_EVENTS=48
# Number of logs retained before and after every strong failure anchor.
LOG_COMPRESSION_CONTEXT_RADIUS=2
# Number of repeated log-pattern summaries kept in the prompt.
LOG_COMPRESSION_MAX_PATTERNS=12
# Maximum characters retained for one selected log message.
LOG_COMPRESSION_MAX_MESSAGE_CHARS=700

# RCA graph pruning and bounded parallel decision calls.
RCA_GRAPH_PRUNING_ENABLED=true
RCA_GRAPH_MAX_EVENTS=24
RCA_GRAPH_CONTEXT_RADIUS=1
RCA_GRAPH_MAX_EVENTS_PER_PATTERN=2
RCA_GRAPH_MAX_ROOT_CANDIDATES=3
RCA_GRAPH_MAX_HYPOTHESES=3
RCA_GRAPH_MAX_EXCEPTIONS=3
RCA_GRAPH_WRITE_UNRESOLVED_SERVICES=false
RCA_GRAPH_WRITE_COOCCURRENCE_EDGES=false
RCA_GRAPH_WRITE_TEMPORAL_EDGES=true
RCA_DECISION_MAX_WORKERS=3
RCA_DECISION_ISOLATE_CONVERSATIONS=true